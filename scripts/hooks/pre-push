#!/usr/bin/env bash
# Block direct pushes to main. Work goes through a branch and a pull request.
# Enable once per clone: git config core.hooksPath scripts/hooks
# Bypass in an emergency: git push --no-verify
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are blocked. Push a branch and open a PR." >&2
    exit 1
  fi
done
exit 0
